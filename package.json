{
  "name": "dsh-restart",
  "version": "1.2.0",
  "private": false,
  "type": "module",
  "description": "DSH restart button with environment detection: on fnOS it restarts through the application gateway and injects a restart item into the fnOS sidebar menu; elsewhere it keeps the vertical sidebar button. Restart preserves the current default model.",
  "description_zh": "「重启 DSH」按钮：自动判断系统环境，飞牛 OS 下通过应用网关正确重启并注入飞牛 OS 侧边栏菜单，其他环境保持竖向按钮；重启时沿用当前默认模型。",
  "author": "lsit27",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsit27/dsh-restart.git"
  },
  "homepage": "https://github.com/lsit27/dsh-restart",
  "bugs": "https://github.com/lsit27/dsh-restart/issues",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "restart"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "restart-helper.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "assets",
    "screenshots.json",
    "icon.svg",
    "README.md",
    "SUBMISSION.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
